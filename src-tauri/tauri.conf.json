{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyMail",
  "version": "0.1.2",
  "identifier": "com.mymail.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyMail",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MTk0MDU4NjQ5NEIxMDgKUldRSXNaUmtXRUFaSjd0Z0pDOVQ2MFBuZWlRd1hSZUx6MERUbTFtcndzenBVdGRJckQwSFpkZUIK",
      "endpoints": ["https://github.com/pyjhoop/MyMail/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
